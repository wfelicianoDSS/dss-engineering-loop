   ],
   "when": [
    "When the idea is **fuzzy** and ==you cannot write it down yet== → [[grill]]",
    "When two people **disagree** on scope → [[grill]]"
   ],
   "whatItIs": "Interviews you, **one question at a time**, until the plan is clear.",
   "howItWorks": [
    "Reads what you wrote",
    "Asks the **next most important** question",
    "Writes the answers into a plan"
   ],
   "example": {
    "situation": "You have a vague idea: invoice reminders.",
    "youType": "/grill invoice reminders",
    "whatHappens": [
     "It asks who sends them.",
