 "categories": [
  {
   "id": "clarify",
   "stage": "plan",
   "name": "Clarify the idea",
   "blurb": "Get the why on paper.",
   "principle": "Do not plan in your head. **Interview first**, then write the why down.",
   "when": [
    "When the idea is fuzzy → start with grill",
    "When you have the answers → write-intent"
   ],
   "chain": [
    "grill",
    "write-intent"
   ],
   "chainWhy": "You cannot write the why before the questions are answered.",
   "sources": [
    {
     "label": "Sample skill pack docs",
     "url": "https://example.com/sample-pack"
    }
   ]
  },
  {
   "id": "break",
